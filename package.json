{
  "name": "rtwiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/server/index.ts",
    "dev:web": "vite",
    "build": "bun run build:web && bun run build:server",
    "build:web": "vite build",
    "build:server": "bun build src/server/index.ts --compile --outfile dist/RTWiki.exe --target=bun-windows-x64",
    "start": "bun run src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "format:check": "biome format --check .",
    "format:fix": "biome check --write .",
    "format:write": "biome format --write .",
    "lint": "biome lint .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "db:migrate": "bun run src/server/database/migrations.ts"
  },
  "dependencies": {
    "@mantine/core": "7.15.0",
    "@tabler/icons-react": "3.20.0",
    "hono": "4.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/bun": "1.3.14",
    "@types/node": "22.9.4",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.2",
    "vite": "5.4.11"
  }
}
