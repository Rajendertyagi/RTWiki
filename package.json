{
  "name": "rtwiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/server/index.ts",
    "dev:web": "vite",
    "build": "bun run build:web && bun run build:server",
    "build:web": "vite build",
    "build:server": "bun build src/server/index.ts --compile --outfile dist/RTWiki.exe --target windows-x64",
    "start": "bun run src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "format:check": "biome check --no-errors-on-unmatched .",
    "format:fix": "biome check --fix .",
    "format:write": "biome format --write .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/server/database/migrations.ts",
    "package": "bun run script/package.ts"
  },
  "dependencies": {
    "@mantine/core": "7.15.0",
    "@mantine/hooks": "7.15.0",
    "@tabler/icons-react": "3.20.0",
    "dompurify": "3.2.3",
    "hono": "4.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/dompurify": "3.0.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "drizzle-kit": "0.30.1",
    "drizzle-orm": "0.39.3",
    "typescript": "5.7.2",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
