{
  "name": "rtwiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/server/index.ts",
    "dev:web": "vite",
    "build": "bun run build:web && bun run build:server",
    "build:web": "vite build",
    "build:server": "bun run scripts/build.ts",
    "build:desktop": "tauri build --no-bundle",
    "desktop:icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-tauri-icons.ps1",
    "start": "bun run src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "format:check": "biome check --linter-enabled=false .",
    "format:fix": "biome check --write .",
    "format:write": "biome format --write .",
    "lint": "biome lint .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:browser": "playwright test",
    "test:compiled-images": "bun build --compile scripts/verify-compiled-image-detection.ts --outfile build/verify-images.exe && build/verify-images.exe",
    "db:migrate": "bun run src/server/database/migrations.ts"
  },
  "dependencies": {
    "@blocknote/core": "0.57.0",
    "@blocknote/mantine": "0.57.0",
    "@blocknote/math-block": "0.57.0",
    "@blocknote/react": "0.57.0",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@lezer/highlight": "1.2.5",
    "@mantine/core": "9.7.4",
    "@mantine/dates": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@mantine/notifications": "9.7.4",
    "@mantine/schedule": "9.7.4",
    "@shikijs/engine-javascript": "4.6.0",
    "@shikijs/langs": "4.6.0",
    "@shikijs/themes": "4.6.0",
    "@tabler/icons-react": "3.50.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-autostart": "2.7.0",
    "@tauri-apps/plugin-notification": "2.8.0",
    "codemirror": "6.0.2",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.17",
    "file-type": "22.3.0",
    "hono": "4.13.16",
    "image-size": "2.0.4",
    "latest": "^0.2.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-to-string": "4.0.0",
    "mermaid": "12.2.0",
    "micromark": "4.0.3",
    "micromark-extension-directive": "4.0.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-util-symbol": "2.0.1",
    "micromark-util-types": "2.0.3",
    "nspell": "2.1.5",
    "officeparser": "8.5.0",
    "parse5": "8.1.0",
    "prettier": "3.9.10",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "shiki": "4.6.0",
    "wunderbaum": "0.15.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@types/bun": "1.4.4",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
