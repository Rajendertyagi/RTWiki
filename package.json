{
  "name": "rtwiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/server/index.ts",
    "dev:web": "vite",
    "build": "bun run build:web && bun run build:server",
    "build:web": "vite build",
    "build:server": "bun run scripts/build.ts",
    "build:desktop": "tauri build --no-bundle",
    "desktop:icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-tauri-icons.ps1",
    "start": "bun run src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "format:check": "biome check --linter-enabled=false .",
    "format:fix": "biome check --write .",
    "format:write": "biome format --write .",
    "lint": "biome lint .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:browser": "playwright test",
    "test:compiled-images": "bun build --compile scripts/verify-compiled-image-detection.ts --outfile build/verify-images.exe && build/verify-images.exe",
    "db:migrate": "bun run src/server/database/migrations.ts"
  },
  "dependencies": {
    "@blocknote/core": "0.54.0",
    "@blocknote/mantine": "0.54.0",
    "@blocknote/math-block": "0.54.0",
    "@blocknote/react": "0.54.0",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@lezer/highlight": "1.2.3",
    "@mantine/core": "9.6.2",
    "@mantine/dates": "9.6.2",
    "@mantine/hooks": "9.6.2",
    "@mantine/notifications": "9.6.2",
    "@mantine/schedule": "9.6.2",
    "@tabler/icons-react": "3.46.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-autostart": "2.5.1",
    "@tauri-apps/plugin-notification": "2.4.0",
    "codemirror": "6.0.2",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.15",
    "file-type": "22.1.1",
    "hono": "4.13.3",
    "image-size": "2.0.4",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-to-string": "4.0.0",
    "mermaid": "12.0.0",
    "micromark": "4.0.3",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "motion": "13.4.4",
    "nspell": "2.1.5",
    "officeparser": "8.0.0",
    "parse5": "8.0.1",
    "prettier": "3.6.2",
    "prosemirror-model": "1.25.11",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "wunderbaum": "0.14.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "2.11.5",
    "@types/bun": "1.4.0",
    "@types/jsdom": "21.1.7",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "26.1.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
