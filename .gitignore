# Bun / npm / yarn dependency caches
node_modules/

# Playwright test output
test-results/
.bun/
.pnpm-store/

# Build and distribution outputs
dist/
build/
out/
.target/
.release/

# Coverage and cache
coverage/
.nyc_output/
.vite/
.eslintcache
tsconfig.tsbuildinfo

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*~

# Environment files (keep the example only)
.env
.env.*
!.env.example

# Logs
*.log
logs/

# Runtime data (created by the application at startup)
data/

# Compiled executables and packaged artifacts
*.exe
*.msi
*.zip
*.tar.gz
*.nupkg
release/

# Tauri shell build outputs (Rust target dir, codegen, sidecar staging).
# Icons, config, and Rust sources are committed; Cargo.lock is committed after
# the first CI build pins the exact dependency versions.
src-tauri/target/
src-tauri/gen/
src-tauri/binaries/

# Windows-generated files
Thumbs.db
desktop.ini
ehthumbs.db

# IDE and editor settings (optional — keep if team uses them)
# .vscode/
# .idea/

# OS metadata
.DS_Store
Thumbs.db

# Scratch and throwaway artefacts, not product sources.
#
# docs/plans holds design mockups and working notes that are useful while a
# change is in progress and are not part of the shipped documentation, which
# lives in docs/ proper. .agnes is scratch output from tooling. Biome reads
# .gitignore (vcs.useIgnoreFile), so leaving these untracked-but-unignored put
# 162 lint errors from mockup HTML into a required CI gate.
docs/plans/
.agnes/