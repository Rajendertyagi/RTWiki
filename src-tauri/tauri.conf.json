{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RTWiki",
  "version": "0.1.0",
  "identifier": "com.rtwiki.app",
  "build": {
    "devUrl": "http://127.0.0.1:8080",
    "frontendDist": "frontend-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
