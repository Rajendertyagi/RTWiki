{
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "all": true,
        "noUnusedVariables": "error",
        "noUndeclaredDependencies": "off",
        "noNodejsModules": "off"
      },
      "suspicious": {
        "all": true,
        "noExplicitAny": "error"
      },
      "complexity": {
        "all": true
      },
      "style": {
        "all": true,
        "useImportType": "off",
        "noUnusedTemplateLiteral": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "none"
    },
    "globals": ["Bun"]
  },
  "organizeImports": {
    "enabled": false
  },
  "files": {
    "ignore": [
      "node_modules/",
      "dist/",
      "bun.lock",
      ".workbuddy-ai/",
      "package.json",
      "tsconfig.json",
      "vite.config.ts",
      "vitest.config.ts",
      "biome.json"
    ]
  }
}
