{
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "all": true,
        "noUnusedVariables": "error"
      },
      "suspicious": {
        "all": true,
        "noExplicitAny": "error"
      },
      "complexity": {
        "all": true
      },
      "style": {
        "all": true
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "none"
    }
  },
  "json": {
    "enabled": false
  },
  "files": {
    "ignores": ["node_modules/", "dist/", "bun.lock", ".workbuddy-ai/"]
  }
}
